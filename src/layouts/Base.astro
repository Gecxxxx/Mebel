---
import Header from '../components/Header.jsx';
import { href, asset } from '../lib/urls.js';
import { business, navigation } from '../data/site.js';
import '../prototype.css';
import '../styles.css';
import '../pages.css';
const { title = 'Семейное ателье мебели в Ельце', description = 'Кухни и мебель по индивидуальным размерам, столы и стулья. Подбор материалов и сопровождение до установки. Ателье мебели Приоритет, Елец.', current = '', noindex = false } = Astro.props;
const pageTitle = `${title} — Приоритет`;
const canonical = new URL(Astro.url.pathname, Astro.site || 'https://gecxxxx.github.io').href;
const indexable = import.meta.env.PUBLIC_INDEXABLE === 'true' && !noindex;
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#191916" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={indexable ? 'index,follow' : 'noindex,follow'} />
    <link rel="canonical" href={canonical} />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Ателье мебели Приоритет" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(asset('dining.webp'), Astro.site || 'https://gecxxxx.github.io').href} />
    <link rel="icon" type="image/svg+xml" href={asset('icons/map-pin.svg')} />
  </head>
  <body>
    <a class="skip-link" href="#content">К содержимому</a>
    <Header current={current} client:load />
    <main id="content"><slot /></main>
    <footer class="full-footer">
      <div class="footer-top"><div class="footer-brand"><a href={href()} class="footer-name">ПРИОРИТЕТ</a><p>Семейное ателье мебели · Елец</p><span>С любовью к вам и своему делу</span></div><div><p class="eyebrow">МЕБЕЛЬ ДЛЯ ВАШЕГО ДОМА</p><nav aria-label="Разделы сайта">{navigation.slice(0, 4).map(([name, path]) => <a href={href(path)}>{name}</a>)}</nav></div><div><p class="eyebrow">ПОЛЕЗНО ЗНАТЬ</p><nav aria-label="Информация">{[['Как заказать', 'how-to-order/'], ['Материалы и фурнитура', 'materials/'], ['Доставка и оплата', 'delivery-payment/'], ['Гарантия и обращения', 'warranty/'], ['Вопросы и ответы', 'faq/']].map(([name, path]) => <a href={href(path)}>{name}</a>)}</nav></div><div class="footer-contact"><p class="eyebrow">БУДЕМ РАДЫ ВСТРЕЧЕ</p><a class="footer-phone" href={`tel:${business.tel}`}>{business.phone}</a><p>Елец, Королева, 1<br />Елец, Александровская, 1/1</p><a href={href('contacts/')} class="text-link">Адреса и часы работы <img class="icon" src={asset('icons/arrow-right.svg')} width="18" height="18" alt="" /></a></div></div>
      <div class="footer-bottom"><span>© {new Date().getFullYear()} Ателье мебели «Приоритет»</span><a href={href('privacy/')}>Конфиденциальность</a><a href="https://vk.com/prioritet12" target="_blank" rel="noreferrer">Мы ВКонтакте</a></div>
    </footer>
  </body>
</html>

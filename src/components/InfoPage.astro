---
import Heading from './Heading.astro';
import ContactBanner from './ContactBanner.astro';
import Locations from './Locations.astro';
import { process, faqs, business } from '../data/site.js';
import { href, asset, requestUrl } from '../lib/urls.js';
const { page } = Astro.props;
---
<Heading label={page.label} title={page.title} intro={page.intro} />
{page.kind === 'process' && <><section class="page-section"><div class="process-list">{process.map(([title, text], i) => <article><span>0{i + 1}</span><h2>{title}</h2><p>{text}</p></article>)}</div></section><section class="page-section reading-panel"><h2>Если вы в другом регионе</h2><p>В Тульской и Воронежской областях возможна дистанционная работа. Сначала вы снимаете предварительные размеры по инструкции, мы рассчитываем проект и согласуем условия. Затем монтажники приезжают на уточняющий замер. Последовательность и возможность работы по вашему адресу обсудим заранее.</p><h2>Уже есть проект?</h2><p>Подготовьте изображения, план помещения и пожелания к материалам. Обсудим возможную комплектацию и следующий шаг.</p></section></>}
{page.kind === 'about' && <><section class="page-section about-editorial"><img src={asset('showroom-0135.webp')} alt="Мебель и сочетания материалов в салоне Приоритет" /><div class="reading-copy"><p class="eyebrow">МЕБЕЛЬ — ЭТО ЛИЧНОЕ</p><h2>Сначала слушаем.<br />Потом предлагаем.</h2><p>Дом у каждого свой: с семейными привычками, любимыми вещами и планами на будущее. Поэтому работу над мебелью мы начинаем со знакомства с вами и вашим пространством.</p><p>«Приоритет» — семейное мебельное ателье в Ельце. Работаем с фабриками-партнёрами, подбираем решения под ваш интерьер и сопровождаем заказ от обсуждения до установки.</p><p>Для нас важны не только внешний вид, но и удобное хранение, доступ к повседневным вещам и то, как мебель будет служить в обычной жизни.</p></div></section><section class="page-section inset-section"><div class="three-notes">{[['Личный разговор', 'Обсуждаем задачу, размеры и пожелания, чтобы предложить подходящие варианты.'], ['Проверенные партнёры', 'Работаем с фабриками, в том числе ГЕОС Идеал. Подбираем материалы и комплектацию под конкретный заказ.'], ['Внимание к деталям', 'Согласуем проект, проверяем мебель после поступления и координируем установку.']].map(([title, text]) => <article><h2>{title}</h2><p>{text}</p></article>)}</div></section><section class="page-section editorial-statement"><p class="eyebrow">ПОЗНАКОМИТЬСЯ БЛИЖЕ</p><h2>Больше историй —<br />в наших работах.</h2><p>Посмотрите проекты на сайте, загляните в салон или почитайте публикации и отзывы в нашей группе.</p><div class="inline-actions"><a class="text-link" href={href('projects/')}>Наши проекты</a><a class="text-link" href="https://vk.com/prioritet12" target="_blank" rel="noreferrer">Приоритет ВКонтакте</a></div></section></>}
{page.kind === 'materials' && <><section class="page-section materials-editorial"><div><img src={asset('showroom-0140.webp')} alt="Древесная фактура, светлые фасады и мягкая обивка в экспозиции" loading="lazy" /><p class="image-caption">Сочетание материалов в экспозиции салона</p></div><div class="reading-copy"><h2>Выбираем глазами.<br />Проверяем в жизни.</h2><p>Фактура дерева, оттенок фасадов и тактильность обивки меняются в зависимости от света и окружения. Поможем сравнить образцы и подобрать сочетание для вашего дома.</p><p>Материал выбираем под задачу: частоту использования, расположение мебели, уход и желаемое впечатление от интерьера.</p><a class="text-link" href={href('showroom/')}>Посмотреть в салоне</a></div></section><section class="page-section"><div class="material-grid">{[['Фасады и корпус', 'ЛДСП, эмаль, плёночные и пластиковые фасады — набор доступных решений зависит от выбранной фабрики и модели. Подберём отделку и согласуем образцы.'], ['Шпон и древесина', 'Живая фактура делает интерьер теплее. В комплектациях ГЕОС Идеал возможны шпон ясеня и элементы из массива.'], ['Рабочие поверхности', 'Подбираем столешницу под бюджет и ежедневную нагрузку. Возможны решения из акрилового камня и кварцевого агломерата — это разные материалы с разными особенностями.'], ['Фурнитура и хранение', 'Обсуждаем ящики, механизмы, угловые системы и внутреннее наполнение. В отдельных комплектациях используется фурнитура Blum.'], ['Обивка и посадка', 'Для столов и стульев сравниваем материалы, оттенки и удобство. Фотография на экране может отличаться от реального цвета ткани.'], ['Освещение', 'При необходимости включаем подсветку в проект. Тип, расположение и дополнительные работы согласуем до заказа.']].map(([title, text]) => <article><h2>{title}</h2><p>{text}</p></article>)}</div></section></>}
{page.kind === 'delivery' && <section class="page-section reading-panel"><div class="reading-section"><p class="eyebrow">ГЕОГРАФИЯ</p><h2>Елец, Липецкая область и Ефремов</h2><p>Это основная территория нашей работы. Здесь первичный замер для мебели по индивидуальному проекту бесплатный. Возможность доставки готовой мебели и условия по вашему адресу уточняем при обращении.</p><p>Заказы в Тульской и Воронежской областях обсуждаем отдельно, с учётом дистанционного проектирования и уточняющего замера.</p></div><div class="reading-section"><p class="eyebrow">СОСТАВ СТОИМОСТИ</p><h2>Что включено и что рассчитывается отдельно</h2><p>Сборка включена в стоимость мебели. Доставка, занос и дополнительные работы оплачиваются отдельно.</p><p>Выпилы, перенос розеток, врезка мойки, установка подсветки и другие операции согласуются по перечню работ. Стоимость доставки зависит от адреса и условий — менеджер рассчитает её для вашего заказа.</p></div><div class="reading-section"><p class="eyebrow">ОПЛАТА</p><h2>Согласованные условия — в договоре</h2><p>Для мебели по индивидуальному проекту обычная предоплата составляет 50%. После поступления заказа на склад вносится оставшаяся оплата в согласованном порядке.</p><p>Способы оплаты, возможные варианты рассрочки и условия для готовой мебели уточните у менеджера до оформления.</p></div><div class="reading-section"><p class="eyebrow">ПОЛУЧЕНИЕ МЕБЕЛИ</p><h2>Подготовимся к доставке вместе</h2><p>Заранее обсудим подъезд к дому, этаж, лифт, особенности проходов и место установки. Дату доставки и необходимые работы согласуем после подтверждения готовности мебели.</p></div></section>}
{page.kind === 'warranty' && <section class="page-section reading-panel"><h2>Условия по вашему заказу</h2><p>Гарантийный срок и порядок обращения зависят от выбранной мебели и зафиксированных условий. Менеджер объяснит их до заказа; точные сведения указываются в договоре и документах на мебель.</p><h2>Если возник вопрос по качеству</h2><ol><li>Свяжитесь с ателье по телефону или в Telegram.</li><li>Подготовьте номер и дату договора, описание ситуации и фотографии.</li><li>Менеджер уточнит детали и согласует следующий шаг.</li></ol><h2>Возврат и обмен</h2><p>Мебель по индивидуальному проекту и готовые товары требуют разного порядка рассмотрения обращения. До покупки уточните условия для конкретной модели, а при возникновении вопроса обратитесь к менеджеру с документами на заказ.</p><a class="button button-gold" href={requestUrl('Другая мебель', 'Вопрос по качеству мебели. Номер договора: ')}>Обсудить обращение<img class="icon" src={asset('icons/arrow-right.svg')} width="20" height="20" alt="" /></a></section>}
{page.kind === 'faq' && <section class="page-section faq-list">{faqs.map(([q, a]) => <details><summary>{q}<img class="icon" src={asset('icons/caret-right.svg')} width="20" height="20" alt="" /></summary><p>{a}</p></details>)}</section>}
{page.kind === 'showroom' && <><section class="page-section showroom-editorial"><div class="showroom-wide"><img src={asset('dining.webp')} alt="Обеденная группа с мягкими зелёными стульями в салоне Приоритет" fetchpriority="high" /></div><div class="showroom-details"><div><p class="eyebrow">БЕЗ СПЕШКИ</p><h2>Увидеть оттенок.<br />Почувствовать фактуру.</h2></div><p>Вживую проще понять масштаб мебели, сравнить материалы и найти удобную посадку. Приезжайте с фотографиями вашего интерьера — обсудим сочетания и возможные решения.</p></div><div class="showroom-mosaic">{[['showroom-0102.webp', 'Стол и стулья в интерьере салона'], ['showroom-0140.webp', 'Сочетание светлых фасадов и древесной фактуры'], ['showroom-0146.webp', 'Мебель и подсветка в экспозиции салона']].map(([image, alt]) => <img src={asset(image)} alt={alt} loading="lazy" />)}</div></section><section class="page-section inset-section"><Locations /></section></>}
{page.kind === 'contacts' && <><section class="page-section contacts-main"><Locations /></section><section class="page-section contact-ways"><div><p class="eyebrow">ОБСУДИТЬ ПРОЕКТ</p><h2>Начать можно<br />с одного звонка.</h2><p>Расскажите, какая мебель нужна, в каком городе находится помещение и что для вас особенно важно.</p></div><div><a class="large-phone" href={`tel:${business.tel}`}>{business.phone}</a><a class="button button-outline" href={business.telegram} target="_blank" rel="noreferrer">Написать в Telegram<img class="icon" src={asset('icons/paper-plane-tilt.svg')} width="20" height="20" alt="" /></a></div></section></>}
{page.kind === 'privacy' && <section class="page-section reading-panel"><h2>Форма обращения</h2><p>В текущей демонстрационной версии форма помогает составить сообщение. Введённые имя, телефон, город и пожелания не отправляются автоматически в ателье и не сохраняются в базе заявок сайта. Чтобы передать обращение менеджеру, вы самостоятельно копируете и отправляете текст в Telegram.</p><h2>Избранное</h2><p>Номера сохранённых моделей хранятся локально в этом браузере, чтобы вы могли вернуться к подборке. Имя и телефон в избранное не записываются. Убрать модель можно повторным нажатием на сердце; всю подборку можно удалить, очистив данные сайта в браузере.</p><h2>Внешние сервисы</h2><p>Ссылки на Telegram, ВКонтакте и карты открывают сайты соответствующих сервисов. У них действуют собственные условия обработки данных.</p><h2>Связаться с ателье</h2><p>Вопросы о работе с обращениями можно обсудить по телефону <a href={`tel:${business.tel}`}>{business.phone}</a>.</p></section>}
{page.kind !== 'privacy' && <ContactBanner kind={['showroom', 'contacts'].includes(page.kind) ? 'Визит в салон' : 'Кухня'} />}

---
import Heading from './Heading.astro';
import ContactBanner from './ContactBanner.astro';
import { projects } from '../data/site.js';
import { href, asset } from '../lib/urls.js';
---
<Heading label="Проекты" title="Продумано для жизни." intro="Реальные решения и экспозиционные примеры. Посмотрите на материалы, детали и то, как мебель работает в пространстве." />
<section class="page-section project-index"><div class="project-index-grid">{projects.map((p, index) => <article class="project-index-card"><a href={href(`projects/${p.slug}/`)} class="project-index-image" aria-label={`Смотреть проект: ${p.name}`}><img src={asset(p.image)} alt={p.name} loading={index === 0 ? 'eager' : 'lazy'} width="960" height="1200" /><span class="project-type">{p.label}</span></a><div class="project-card-kicker"><p class="eyebrow">{p.type}</p><span>0{index + 1}</span></div><h2><a href={href(`projects/${p.slug}/`)}>{p.name}</a></h2><p>{p.intro}</p><a class="text-link" href={href(`projects/${p.slug}/`)}>Смотреть проект<img class="icon" src={asset('icons/arrow-right.svg')} width="20" height="20" alt="" /></a></article>)}</div></section>
<ContactBanner />

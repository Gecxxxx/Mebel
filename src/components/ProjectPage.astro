---
import Heading from './Heading.astro';
import Gallery from './Gallery.jsx';
import WorkPhoto from './WorkPhoto.astro';
import ContactBanner from './ContactBanner.astro';
import { requestUrl, asset, href } from '../lib/urls.js';
import { projects } from '../data/site.js';
const { project: p } = Astro.props;
const nextProject = projects.find(project => project.slug !== p.slug && project.type === p.type) || projects.find(project => project.slug !== p.slug);
---
<Heading label={p.type} title={p.title} intro={p.intro} parent={['Наши работы', 'projects/']} />
<nav class="case-page-nav" aria-label="Навигация по альбому"><a href={href(p.category ? `projects/?category=${p.category}` : 'projects/')}><img class="icon" src={asset('icons/arrow-left.svg')} width="18" height="18" alt="" />Все работы в категории</a><div><a href="#project-details">О работе</a>{!p.album && <a href="#project-materials">Материалы и детали</a>}</div></nav>
<section class="page-section project-case" class:list={{ 'album-case': p.album }}><Gallery images={p.images} title={p.name} album={p.album} client:load /><div class="case-story" id="project-details"><p class="eyebrow">{p.label}</p>
{p.album ? <><section class="case-block"><span class="case-number">АЛЬБОМ РАБОТЫ</span><h2>Рассмотрите поближе.</h2><p>{p.intro}</p><p>Листайте фотографии и открывайте их на весь экран, чтобы увидеть детали.</p></section><dl class="album-facts"><div><dt>Направление</dt><dd>{p.type}</dd></div><div><dt>В альбоме</dt><dd>{p.images.length} фото</dd></div></dl><p class="case-price-note">Понравилась идея? Размеры, материалы и наполнение подберём под ваш интерьер. Комплектацию и стоимость согласуем индивидуально.</p></> : <><section class="case-block"><span class="case-number">01 / ЗАДАЧА</span><h2>Задача проекта</h2><p>{p.task}</p></section><section class="case-block"><span class="case-number">02 / РЕШЕНИЕ</span><h2>Наше решение</h2><p>{p.solution}</p></section><section class="case-block" id="project-materials"><span class="case-number">03 / МАТЕРИАЛЫ</span><h2>Материалы и детали</h2><dl class="specifications">{p.specs.map(([key, value]) => <div><dt>{key}</dt><dd>{value}</dd></div>)}</dl></section><p class="case-price-note">{p.note}</p></>}
<a class="button button-gold" href={requestUrl(p.kind, `Понравилась работа: ${p.name}`)}>Обсудить похожий проект<img class="icon" src={asset('icons/arrow-right.svg')} width="20" height="20" alt="" /></a></div></section>
{nextProject && <section class="page-section next-project warm-section"><a class="next-project-image" href={href(`projects/${nextProject.slug}/`)}><WorkPhoto photo={nextProject.cover || { image: nextProject.image }} alt={nextProject.name} /></a><div><p class="eyebrow">ЕЩЁ ОДНА ИСТОРИЯ</p><h2><a href={href(`projects/${nextProject.slug}/`)}>{nextProject.name}</a></h2><p>{nextProject.intro}</p><a class="text-link" href={href(`projects/${nextProject.slug}/`)}>Открыть альбом<img class="icon" src={asset('icons/arrow-right.svg')} width="20" height="20" alt="" /></a></div></section>}
<ContactBanner kind={p.kind} />

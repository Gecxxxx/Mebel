---
import Heading from './Heading.astro';
import Gallery from './Gallery.jsx';
import ContactBanner from './ContactBanner.astro';
import { requestUrl, asset } from '../lib/urls.js';
const { project: p } = Astro.props;
---
<Heading label={p.name} title={p.title} intro={p.intro} parent={['Проекты', 'projects/']} />
<section class="page-section project-case"><Gallery images={p.images} title={p.name} client:load /><div class="case-story"><p class="eyebrow">{p.label}</p><h2>Задача</h2><p>{p.task}</p><h2>Решение</h2><p>{p.solution}</p><dl class="specifications">{p.specs.map(([key, value]) => <div><dt>{key}</dt><dd>{value}</dd></div>)}</dl><p class="case-price-note">{p.note}</p><a class="button button-gold" href={requestUrl(p.kind, `Понравился проект: ${p.name}`)}>Обсудить похожий проект<img class="icon" src={asset('icons/arrow-right.svg')} width="20" height="20" alt="" /></a></div></section>
<ContactBanner kind={p.kind} />

---
import { href, asset, requestUrl } from '../lib/urls.js';
import products from '../data/catalog.json';
import { ProductCard } from './Catalog.jsx';
import { process, business } from '../data/site.js';
import { photos, showroomPhotos } from '../data/photos.js';
import Photo from './Photo.astro';
import PhotoCarousel from './PhotoCarousel.jsx';
import ContactBanner from './ContactBanner.astro';
const picks = [products.find(p => p.category === 'stoly'), products.find(p => p.slug === 'stul-fred'), products.find(p => p.category === 'stoly' && p.slug.includes('arden'))];
---
<section class="hero" aria-labelledby="hero-title"><div class="hero-copy"><p class="eyebrow">СЕМЕЙНОЕ АТЕЛЬЕ МЕБЕЛИ · ЕЛЕЦ</p><h1 id="hero-title">Мебель, которая становится частью дома</h1><p class="hero-description">Подберём кухню и мебель под ваш интерьер. Сопроводим от замера до установки.</p><div class="hero-actions"><a class="button button-gold" href={requestUrl()}>Обсудить проект</a><a class="text-link" href={href('projects/')}>Смотреть проекты<img class="icon" src={asset('icons/arrow-right.svg')} width="20" height="20" alt="" /></a></div></div><div class="hero-image"><img src={asset('kitchen.webp')} alt="Кухня из дерева и камня в экспозиции ателье Приоритет" fetchpriority="high" width="1280" height="853" /></div></section>
<section class="service-strip" aria-label="Сопровождение вашего проекта"><div><h2>Индивидуальный проект</h2><p>Учитываем пространство,<br />ваши привычки и стиль жизни.</p></div><div><h2>Подбор материалов</h2><p>Помогаем выбрать надёжные<br />и практичные решения.</p></div><div><h2>Сборка и установка</h2><p>Координируем все этапы<br />с проверенными партнёрами.</p></div></section>
<section class="home-directions page-section"><div class="section-title"><p class="eyebrow">ОТ ПЕРВОЙ ИДЕИ ДО ДЕТАЛЕЙ</p><h2>Всё начинается с вашего дома.</h2></div><div class="direction-links">
  <a href={href('kuhni/')}><div class="direction-photo direction-photo--kitchen"><Photo photo={photos.facades} sizes="(max-width: 600px) 100vw, 33vw" /></div><div class="direction-link-copy"><span class="direction-number">01</span><div><h3>Кухни</h3><p>По размерам помещения и вашим привычкам</p></div><img class="icon" src={asset('icons/arrow-right.svg')} width="24" height="24" alt="" /></div></a>
  <a href={href('mebel-na-zakaz/')}><div class="direction-photo direction-photo--storage"><img src={asset('staircase-drawers.jpg')} alt="Выдвижные секции мебели под лестницей в реализованном проекте" width="960" height="1280" loading="lazy" /></div><div class="direction-link-copy"><span class="direction-number">02</span><div><h3>Мебель на заказ</h3><p>Шкафы, гардеробные и сложные пространства</p></div><img class="icon" src={asset('icons/arrow-right.svg')} width="24" height="24" alt="" /></div></a>
  <a href={href('catalog/')}><div class="direction-photo"><Photo photo={photos.diningWide} sizes="(max-width: 600px) 100vw, 33vw" /></div><div class="direction-link-copy"><span class="direction-number">03</span><div><h3>Столы и стулья</h3><p>Мебель для тёплых встреч каждый день</p></div><img class="icon" src={asset('icons/arrow-right.svg')} width="24" height="24" alt="" /></div></a>
</div></section>
<section class="projects-section" aria-labelledby="projects-title"><div class="projects-heading"><div><p class="eyebrow">ВНИМАНИЕ К ДЕТАЛЯМ</p><h2 id="projects-title">Продумано для жизни</h2></div><p>Кухни, шкафы и другая мебель,<br />которая помогает создать уютный<br class="wide-break" /> и удобный дом.</p></div><div class="projects-grid"><article class="project-card staircase-card"><a class="project-image-button" href={href('projects/shkaf-pod-lestnicey/')}><img src={asset('staircase-overall.jpg')} alt="Встроенный шкаф с реечными фасадами под лестницей" loading="lazy" width="960" height="1280" /><span class="image-action"><img class="icon" src={asset('icons/arrow-right.svg')} width="24" height="24" alt="" /></span></a><div class="project-caption"><a class="project-title" href={href('projects/shkaf-pod-lestnicey/')}>Шкаф под лестницей</a><span class="caption-rule"></span><p>Рационально используем пространство<br />и сохраняем единый стиль интерьера.</p></div></article><article class="project-card dining-card"><a class="project-image-button" href={href('catalog/obedennye-gruppy/')}><img src={asset('dining.webp')} alt="Светлый стол и мягкие зелёные стулья в шоуруме" loading="lazy" width="1280" height="853" /><span class="image-action"><img class="icon" src={asset('icons/arrow-right.svg')} width="24" height="24" alt="" /></span></a><div class="project-caption"><a class="project-title" href={href('catalog/obedennye-gruppy/')}>Обеденная группа в шоуруме</a><div class="dining-caption-detail"><span class="caption-rule"></span><p>Столы и стулья для уютных семейных<br />ужинов и тёплых встреч.</p></div></div></article></div></section>
<section class="home-catalog page-section"><div class="section-heading-line"><div class="section-title"><p class="eyebrow">ГОТОВЫЕ РЕШЕНИЯ</p><h2>Собраться за одним столом.</h2></div><a class="text-link" href={href('catalog/')}>Весь каталог<img class="icon" src={asset('icons/arrow-right.svg')} width="20" height="20" alt="" /></a></div><div class="catalog-grid home-product-grid">{picks.filter(Boolean).map(p => <ProductCard product={p} />)}</div><p class="catalog-source-note">Цены — ориентиры из прежнего каталога. Актуальную стоимость и наличие уточним при обращении.</p></section>
<section class="home-about page-section"><div class="about-photo-composition"><figure class="about-photo-portrait"><Photo photo={photos.welcome} sizes="(max-width: 600px) 55vw, 30vw" /></figure><figure class="about-photo-detail"><Photo photo={photos.materials} sizes="(max-width: 600px) 35vw, 20vw" /><figcaption>Личное знакомство.<br />Внимание к каждой детали.</figcaption></figure></div><div class="editorial-copy"><p class="eyebrow">СЕМЕЙНОЕ АТЕЛЬЕ</p><h2>Личное отношение.<br />Продуманный результат.</h2><p>Помогаем подобрать мебель, которая подходит вашему пространству, образу жизни и планам. Работаем с фабриками-партнёрами и сопровождаем каждый этап — от первого знакомства до установки.</p><a class="text-link" href={href('about/')}>Ближе познакомиться<img class="icon" src={asset('icons/arrow-right.svg')} width="20" height="20" alt="" /></a></div></section>
<section class="page-section home-process"><div class="section-heading-line"><div class="section-title"><p class="eyebrow">ПОНЯТНЫЙ ПУТЬ</p><h2>От идеи до установки.</h2></div><a class="text-link" href={href('how-to-order/')}>Как мы работаем<img class="icon" src={asset('icons/arrow-right.svg')} width="20" height="20" alt="" /></a></div><div class="small-steps">{[process[0], process[2], process[5]].map(([title, text], i) => <article>{i < 2 ? <Photo photo={i === 0 ? photos.space : photos.materials} class="process-photo" sizes="(max-width: 600px) 100vw, 33vw" /> : <img class="process-photo" src={asset('staircase-detail.jpg')} alt="Готовая мебель под лестницей: фасады и выдвижные секции" width="960" height="1280" loading="lazy" />}<span>0{i + 1}</span><h3>{title}</h3><p>{text}</p></article>)}</div></section>
<section class="home-photo-tour" aria-labelledby="photo-tour-title"><div class="photo-tour-heading page-section"><div class="section-title"><p class="eyebrow">ФОТОГРАФИИ НАШЕГО САЛОНА</p><h2 id="photo-tour-title">Загляните в наше ателье.</h2></div><div class="photo-tour-intro"><p>Кухни, обеденные группы, фасады и детали — фотографии салона на Александровской, 1/1. Посмотрите ближе и найдите то, что откликается вам.</p><a class="text-link" href={href('showroom/')}>Больше о шоуруме<img class="icon" src={asset('icons/arrow-right.svg')} width="20" height="20" alt="" /></a></div></div><PhotoCarousel photos={showroomPhotos} client:visible /></section>
<section class="home-visit page-section"><Photo photo={photos.exterior} class="visit-photo" sizes="(max-width: 600px) 100vw, 55vw" /><div><p class="eyebrow">ПРИХОДИТЕ ЗНАКОМИТЬСЯ</p><h2>Посмотрите. Прикоснитесь. Выберите своё.</h2><p class="visit-address"><img class="icon" src={asset('icons/map-pin.svg')} width="22" height="22" alt="" />Елец, Александровская, 1/1</p><div class="visit-hours">{business.places[0].hours.map(hours => <span>{hours}</span>)}</div><div class="visit-actions"><a class="visit-phone" href={`tel:${business.places[0].tel}`}>{business.places[0].phone}</a><a class="text-link" href={href('contacts/')}>Адреса и маршрут<img class="icon" src={asset('icons/arrow-right.svg')} width="18" height="18" alt="" /></a></div></div></section>
<ContactBanner />

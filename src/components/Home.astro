---
import { href, asset, requestUrl } from '../lib/urls.js';
import products from '../data/products.js';
import { ProductCard } from './Catalog.jsx';
import { process, business, supportPromise, projects } from '../data/site.js';
import { photos, showroomPhotos } from '../data/photos.js';
import Photo from './Photo.astro';
import PhotoCarousel from './PhotoCarousel.jsx';
import ContactBanner from './ContactBanner.astro';
import WorkCard from './WorkCard.astro';
import WorkPhoto from './WorkPhoto.astro';
import ProcessSummary from './ProcessSummary.astro';
import ProjectQuiz from './ProjectQuiz.jsx';
import MaterialsDownload from './MaterialsDownload.astro';
import PromotionCallout from './PromotionCallout.astro';
import HomeVideo from './HomeVideo.astro';
import { workBySlug, homeInspiration, homeShowroomPhotos } from '../data/editorial.js';
const featuredWorks = projects.filter(p => p.album).slice(0, 4);
const picks = [products.find(p => p.category === 'stoly'), products.find(p => p.slug === 'stul-fred'), products.find(p => p.category === 'stoly' && p.slug.includes('arden'))];
---
<section class="hero" aria-labelledby="hero-title"><div class="hero-copy"><p class="eyebrow">СЕМЕЙНОЕ АТЕЛЬЕ МЕБЕЛИ</p><h1 id="hero-title">Мебель, которая становится частью дома</h1><p class="hero-description">Кухни, шкафы, гардеробные и мебель для каждой комнаты — по вашим размерам и под ваш интерьер. Сопроводим от замера до установки.</p><div class="hero-actions"><a class="button button-gold" href={requestUrl()}>Обсудить проект</a><a class="text-link" href={href('projects/')}>Смотреть наши работы<img class="icon" src={asset('icons/arrow-right.svg')} width="20" height="20" alt="" /></a></div></div><div class="hero-image"><WorkPhoto photo={workBySlug('kuhnya-s-ostrovom').cover} loading="eager" fetchpriority="high" sizes="(max-width: 900px) 100vw, 50vw" /></div></section>
<section class="service-strip" aria-label="Сопровождение вашего проекта"><div><h2>Индивидуальный проект</h2><p>Учитываем пространство,<br />ваши привычки и стиль жизни.</p></div><div><h2>Подбор материалов</h2><p>Помогаем выбрать надёжные<br />и практичные решения.</p></div><div><h2>Сборка и установка</h2><p>Координируем все этапы<br />с проверенными партнёрами.</p></div></section>
<section class="home-directions page-section"><div class="section-title"><p class="eyebrow">ОТ ПЕРВОЙ ИДЕИ ДО ДЕТАЛЕЙ</p><h2>Мебель на заказ для вашего дома.</h2></div><div class="direction-links">
  <a href={href('kuhni/')}><div class="direction-photo direction-photo--kitchen"><WorkPhoto photo={workBySlug('kuhnya-svetlaya-klassika').cover} sizes="(max-width: 600px) 100vw, 33vw" /></div><div class="direction-link-copy"><span class="direction-number">01</span><div><h3>Кухни</h3><p>По размерам помещения и вашим привычкам</p></div><img class="icon" src={asset('icons/arrow-right.svg')} width="24" height="24" alt="" /></div></a>
  <a href={href('korpusnaya-mebel/')}><div class="direction-photo direction-photo--storage"><WorkPhoto photo={workBySlug('garderobnaya-s-podsvetkoy').cover} sizes="(max-width: 600px) 100vw, 33vw" /></div><div class="direction-link-copy"><span class="direction-number">02</span><div><h3>Корпусная мебель</h3><p>Мебель для каждой комнаты и встроенные решения</p></div><img class="icon" src={asset('icons/arrow-right.svg')} width="24" height="24" alt="" /></div></a>
  <a href={href('stoly-i-stulya/')}><div class="direction-photo"><Photo photo={photos.diningWide} sizes="(max-width: 600px) 100vw, 33vw" /></div><div class="direction-link-copy"><span class="direction-number">03</span><div><h3>Столы и стулья</h3><p>Мебель для тёплых встреч каждый день</p></div><img class="icon" src={asset('icons/arrow-right.svg')} width="24" height="24" alt="" /></div></a>
</div></section>
<section class="home-inspiration"><div class="page-section section-heading-line"><div class="section-title"><p class="eyebrow">ПОДСМОТРЕТЬ ИДЕЮ ДЛЯ СВОЕГО ДОМА</p><h2>Разная мебель. Ваш характер.</h2></div><a class="text-link" href={href('projects/')}>Наши работы<img class="icon" src={asset('icons/arrow-right.svg')} width="20" height="20" alt="" /></a></div><PhotoCarousel photos={homeInspiration} label="Идеи для вашего дома" client:visible /></section>
<ProjectQuiz client:visible />
<HomeVideo />
<PromotionCallout />
<section class="page-section home-works warm-section" aria-labelledby="projects-title"><div class="section-heading-line"><div class="section-title"><p class="eyebrow">МЕБЕЛЬ В НАСТОЯЩИХ ДОМАХ</p><h2 id="projects-title">У каждого дома своя история.</h2></div><a class="text-link" href={href('projects/')}>Все наши работы<img class="icon" src={asset('icons/arrow-right.svg')} width="20" height="20" alt="" /></a></div><p class="works-section-intro">Кухни, гардеробные и уютные комнаты. Посмотрите, как разные идеи становятся частью повседневной жизни.</p><div class="work-grid home-work-grid">{featuredWorks.map((p, index) => <WorkCard project={p} index={index} loading="lazy" />)}</div></section>
<section class="home-catalog page-section"><div class="section-heading-line"><div class="section-title"><p class="eyebrow">ГОТОВЫЕ РЕШЕНИЯ</p><h2>Собраться за одним столом.</h2></div><a class="text-link" href={href('stoly-i-stulya/')}>Все столы и стулья<img class="icon" src={asset('icons/arrow-right.svg')} width="20" height="20" alt="" /></a></div><div class="catalog-grid home-product-grid">{picks.filter(Boolean).map(p => <ProductCard product={p} />)}</div><p class="catalog-source-note">Стоимость уточняйте. Поможем подобрать исполнение и проверим доступность модели перед заказом.</p></section>
<section class="home-about page-section"><div class="about-photo-composition"><figure class="about-photo-portrait"><WorkPhoto photo={workBySlug('shkaf-otkrytoe-napolnenie').cover} sizes="(max-width: 600px) 55vw, 30vw" /></figure><figure class="about-photo-detail"><WorkPhoto photo={workBySlug('shkaf-otkrytoe-napolnenie').images[1]} sizes="(max-width: 600px) 35vw, 20vw" /><figcaption>Личное знакомство.<br />Внимание к каждой детали.</figcaption></figure></div><div class="editorial-copy"><p class="eyebrow">СЕМЕЙНОЕ АТЕЛЬЕ</p><h2>Личное отношение.<br />Продуманный результат.</h2><p>Помогаем подобрать мебель, которая подходит вашему пространству, образу жизни и планам. Работаем с фабриками-партнёрами и сопровождаем каждый этап — от первого знакомства до установки.</p><a class="text-link" href={href('about/')}>Ближе познакомиться<img class="icon" src={asset('icons/arrow-right.svg')} width="20" height="20" alt="" /></a><a class="text-link home-about-video-link" href="#atelier-video">Посмотреть видеовизитку · 53 секунды<img class="icon" src={asset('icons/arrow-right.svg')} width="18" height="18" alt="" /></a></div></section>
<ProcessSummary />
<MaterialsDownload compact />
<section class="home-photo-tour" aria-labelledby="photo-tour-title"><div class="photo-tour-heading page-section"><div class="section-title"><p class="eyebrow">ФОТОГРАФИИ НАШЕГО САЛОНА</p><h2 id="photo-tour-title">Загляните в наше ателье.</h2></div><div class="photo-tour-intro"><p>Кухни, обеденные группы, фасады и детали — фотографии салона на Александровской, 1/1. Посмотрите ближе и найдите то, что откликается вам.</p><a class="text-link" href={href('showroom/')}>Больше о шоуруме<img class="icon" src={asset('icons/arrow-right.svg')} width="20" height="20" alt="" /></a></div></div><PhotoCarousel photos={homeShowroomPhotos} label="Фотографии нашего салона" client:visible /></section>
<section class="home-visit page-section"><Photo photo={photos.exterior} class="visit-photo" sizes="(max-width: 600px) 100vw, 55vw" /><div><p class="eyebrow">ПРИХОДИТЕ ЗНАКОМИТЬСЯ</p><div class="visit-welcome"><img src={asset('kitchen.webp')} alt="Хозяйка ателье в салоне" width="120" height="160" loading="lazy" /><div><h2>Приходите знакомиться.</h2><p>Хозяйка ателье поможет с выбором и обсудит вашу идею за чашкой чая.</p></div></div><p class="visit-address"><img class="icon" src={asset('icons/map-pin.svg')} width="22" height="22" alt="" />Елец, Александровская, 1/1</p><div class="visit-hours">{business.places[0].hours.map(hours => <span>{hours}</span>)}</div><div class="visit-actions"><a class="visit-phone" href={`tel:${business.places[0].tel}`}>{business.places[0].phone}</a><a class="text-link" href={href('contacts/')}>Адреса и маршрут<img class="icon" src={asset('icons/arrow-right.svg')} width="18" height="18" alt="" /></a></div></div></section>
<ContactBanner />

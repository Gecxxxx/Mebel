---
import Heading from './Heading.astro';
import ContactBanner from './ContactBanner.astro';
import WorkCard from './WorkCard.astro';
import { asset, href, requestUrl } from '../lib/urls.js';
import { projects, process, supportPromise } from '../data/site.js';
const { service, path } = Astro.props;
const related = projects.filter(p => service.workTypes.includes(p.type) && p.album).slice(0, 6);
---
<section class="service-hero"><div><Heading label={service.name} title={service.title} intro={service.intro} parent={path.includes('/') ? ['Корпусная мебель', 'korpusnaya-mebel/'] : null} /><a class="button button-gold" href={requestUrl(service.kind)}>Обсудить проект<img class="icon" src={asset('icons/arrow-right.svg')} width="20" height="20" alt="" /></a></div><figure><img src={asset(service.image)} alt={service.alt} fetchpriority="high" /><figcaption>{service.caption}</figcaption></figure></section>
<section class="page-section"><div class="three-notes">{service.blocks.map(([title, text], i) => <article><span class="note-number">0{i + 1}</span><h2>{title}</h2><p>{text}</p></article>)}</div></section>
<section class="page-section inset-section"><div class="section-title"><p class="eyebrow">ПОДХОДЯЩЕЕ РЕШЕНИЕ</p><h2>У каждого дома свой характер.</h2></div><div class="solution-grid">{service.choices.map(([title, text, link]) => <article><h3>{title}</h3><p>{text}</p>{link && <a href={href(link)} class="text-link">Подробнее<img class="icon" src={asset('icons/arrow-right.svg')} width="18" height="18" alt="" /></a>}</article>)}</div></section>
<section class="page-section editorial-statement"><p class="eyebrow">О СТОИМОСТИ</p><h2>Комплектация важнее<br />условной цены «от».</h2><p>{service.detail}</p><a class="text-link" href={href('materials/')}>Посмотреть материалы<img class="icon" src={asset('icons/arrow-right.svg')} width="20" height="20" alt="" /></a></section>
<section class="page-section warm-section"><div class="section-heading-line"><div class="section-title"><p class="eyebrow">ФОТОГРАФИИ РАБОТ АТЕЛЬЕ</p><h2>Всё складывается в ваш дом.</h2></div><a class="text-link" href={href(path === 'kuhni' ? 'projects/?category=kuhni' : 'projects/')}>Все наши работы<img class="icon" src={asset('icons/arrow-right.svg')} width="20" height="20" alt="" /></a></div><div class="work-grid">{related.map((p, index) => <WorkCard project={p} index={index} />)}</div></section>
<section class="page-section inset-section"><div class="section-title"><p class="eyebrow">СОПРОВОЖДАЕМ КАЖДЫЙ ЭТАП</p><h2>Понятный путь к результату.</h2></div><div class="small-steps">{[process[0], process[2], supportPromise].map(([title, text], i) => <article><span>0{i + 1}</span><h3>{title}</h3><p>{text}</p></article>)}</div><a class="text-link" href={href('how-to-order/')}>Все этапы заказа<img class="icon" src={asset('icons/arrow-right.svg')} width="20" height="20" alt="" /></a></section>
<ContactBanner kind={service.kind} />

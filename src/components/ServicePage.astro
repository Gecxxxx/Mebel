---
import Heading from './Heading.astro';
import ContactBanner from './ContactBanner.astro';
import WorkCard from './WorkCard.astro';
import WorkPhoto from './WorkPhoto.astro';
import PhotoCarousel from './PhotoCarousel.jsx';
import ProcessSummary from './ProcessSummary.astro';
import ProjectExamples from './ProjectExamples.astro';
import MaterialsDownload from './MaterialsDownload.astro';
import { asset, href, requestUrl } from '../lib/urls.js';
import { projects } from '../data/site.js';
import { furnitureTiles, workBySlug, carouselPhoto } from '../data/editorial.js';
const { service, path } = Astro.props;
const related = projects.filter(p => service.workTypes.includes(p.type) && p.album).slice(0, 6);
const isFurniture = path === 'korpusnaya-mebel';
const photos = related.map(carouselPhoto);
---
<section class="service-hero"><div><Heading label={isFurniture ? 'ДЛЯ КАЖДОЙ КОМНАТЫ' : service.name} title={service.title} intro={service.intro} parent={path.includes('/') ? ['Корпусная мебель', 'korpusnaya-mebel/'] : null} /><a class="button button-gold" href={requestUrl(service.kind)}>Обсудить проект<img class="icon" src={asset('icons/arrow-right.svg')} width="20" height="20" alt="" /></a></div><figure>{service.photo ? <WorkPhoto photo={service.photo} loading="eager" sizes="(max-width: 900px) 100vw, 50vw" /> : <img src={asset(service.image)} alt={service.alt} fetchpriority="high" />}<figcaption>{service.photo ? 'Фотография работы ателье' : service.caption}</figcaption></figure></section>
{isFurniture ? <section class="page-section furniture-directions"><div class="section-title"><p class="eyebrow">НАЙДЁМ МЕСТО ВАШЕЙ ИДЕЕ</p><h2>Одна комната или целый дом.</h2></div><div class="furniture-tile-grid">{furnitureTiles.map(tile => <a class="furniture-tile" href={href(tile.link)}><WorkPhoto photo={workBySlug(tile.work).cover} sizes="(max-width: 600px) 100vw, 33vw" /><div><h3>{tile.title}</h3><p>{tile.text}</p><img class="icon" src={asset('icons/arrow-right.svg')} width="22" height="22" alt="" /></div></a>)}</div></section> : <section class="page-section"><div class="three-notes">{service.blocks.map(([title, text], i) => <article><span class="note-number">0{i + 1}</span><h2>{title}</h2><p>{text}</p></article>)}</div></section>}
<section class="service-photo-section"><div class="page-section section-heading-line"><div class="section-title"><p class="eyebrow">РАБОТЫ АТЕЛЬЕ В ДЕТАЛЯХ</p><h2>Посмотрите ближе.</h2></div><a class="text-link" href={href(path === 'kuhni' ? 'projects/?category=kuhni' : 'projects/')}>Все наши работы<img class="icon" src={asset('icons/arrow-right.svg')} width="20" height="20" alt="" /></a></div><PhotoCarousel photos={photos} label="Галерея работ по направлению" client:visible /></section>
{!isFurniture && <section class="page-section inset-section"><div class="section-title"><p class="eyebrow">ПОДХОДЯЩЕЕ РЕШЕНИЕ</p><h2>У каждого дома свой характер.</h2></div><div class="solution-grid">{service.choices.map(([title, text, link]) => <article><h3>{title}</h3><p>{text}</p>{link && <a href={href(link)} class="text-link">Подробнее<img class="icon" src={asset('icons/arrow-right.svg')} width="18" height="18" alt="" /></a>}</article>)}</div></section>}
<section class="page-section compact-cost"><div><p class="eyebrow">О СТОИМОСТИ</p><h2>Сначала ваша идея. Затем точный расчёт.</h2></div><div><p>{service.detail}</p><a class="text-link" href={href('materials/')}>Материалы и фурнитура</a></div></section>
<ProcessSummary />
{['kuhni', 'korpusnaya-mebel'].includes(path) && <><ProjectExamples category={path} /><MaterialsDownload /></>}
<ContactBanner kind={service.kind} />

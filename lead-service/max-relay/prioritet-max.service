[Unit]
Description=Prioritet MAX webhook relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=prioritet-max
Group=prioritet-max
WorkingDirectory=/opt/prioritet-max
EnvironmentFile=/etc/prioritet-max.env
ExecStart=/usr/bin/node /opt/prioritet-max/server.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=128M

[Install]
WantedBy=multi-user.target
